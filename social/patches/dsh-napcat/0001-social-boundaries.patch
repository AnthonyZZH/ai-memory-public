+import { lookup as dnsLookup } from 'node:dns/promises';
+import { isIP, BlockList } from 'node:net';
+import http from 'node:http';
+import https from 'node:https';
+
+const blocked = new BlockList();
+for (const [ip, bits] of [
+  ['0.0.0.0',8], ['10.0.0.0',8], ['100.64.0.0',10], ['127.0.0.0',8],
+  ['169.254.0.0',16], ['172.16.0.0',12], ['192.0.0.0',24], ['192.0.2.0',24],
+  ['192.88.99.0',24], ['192.168.0.0',16], ['198.18.0.0',15],
+  ['198.51.100.0',24], ['203.0.113.0',24], ['224.0.0.0',3],
+]) blocked.addSubnet(ip, bits, 'ipv4');
+for (const [ip, bits] of [['2001::',23], ['2001:db8::',32], ['2002::',16], ['3fff::',20]]) blocked.addSubnet(ip,bits,'ipv6');
+const global6 = new BlockList(); global6.addSubnet('2000::',3,'ipv6');
+export function publicAddress(ip) {
+  const family = isIP(ip);
+  return family === 4 ? !blocked.check(ip, 'ipv4')
+    : family === 6 && global6.check(ip,'ipv6') && !blocked.check(ip,'ipv6');
+}
+function abortable(job, signal) {
+  return new Promise((resolve, reject) => {
+    const abort = () => reject(new Error('SOCIAL_DOWNLOAD_TIMEOUT'));
+    signal.addEventListener('abort',abort,{once:true});
+    if (signal.aborted) abort();
+    Promise.resolve(job).then(resolve,reject).finally(() => signal.removeEventListener('abort',abort));
+  });
+}
+/** The dependency parameters are test seams, never loaded from plugin/model config.
+ * DNS answers are all checked and the selected address is pinned into request.lookup
+ * (no second DNS resolution, no environment HTTP proxy, no connection pool reuse).
+ */
+export async function safeDownload(raw, maxBytes, {
+  lookup = host => dnsLookup(host,{all:true,verbatim:true}),
+  request = (url, options, receive) => (url.protocol === 'https:' ? https : http).request(url,options,receive),
+  timeoutMs = 10000, maxRedirects = 3,
+} = {}) {
+  if (!Number.isSafeInteger(maxBytes) || maxBytes < 1 || maxBytes > 20*1024*1024) throw new Error('SOCIAL_DOWNLOAD_LIMIT');
+  const signal = AbortSignal.timeout(timeoutMs);
+  let url;
+  try { url = new URL(raw); } catch { throw new Error('SOCIAL_URL_DENIED'); }
+  for (let hop = 0; hop <= maxRedirects; hop++) {
+    if (!['http:','https:'].includes(url.protocol) || url.username || url.password || url.hash ||
+        (url.port && !['80','443'].includes(url.port))) throw new Error('SOCIAL_URL_DENIED');
+    const host = url.hostname.replace(/^\[|\]$/g,'');
+    let answers;
+    try { answers = isIP(host) ? [{address:host,family:isIP(host)}] : await abortable(lookup(host),signal); }
+    catch { throw new Error(signal.aborted ? 'SOCIAL_DOWNLOAD_TIMEOUT' : 'SOCIAL_DNS_FAILED'); }
+    if (!answers.length || answers.some(a => !publicAddress(a.address))) throw new Error('SOCIAL_URL_DENIED');
+    const chosen = answers[0];
+    const result = await new Promise((resolve,reject) => {
+      const req = request(url, { method:'GET', agent:false, signal, autoSelectFamily:false,
+        headers: {Accept:'application/octet-stream'},
+        lookup: (_host, options, done) => options.all
+          ? done(null,[chosen]) : done(null,chosen.address,chosen.family),
+      }, response => {
+        const status = response.statusCode || 0;
+        if ([301,302,303,307,308].includes(status)) {
+          const location = response.headers.location;
+          response.destroy();
+          if (!location || hop === maxRedirects) reject(new Error('SOCIAL_REDIRECT_DENIED'));
+          else resolve({location});
+          return;
+        }
+        if (status !== 200) { response.destroy();reject(new Error('SOCIAL_DOWNLOAD_FAILED'));return; }
+        const declared = response.headers['content-length'];
+        if (declared && (!/^\d+$/.test(declared) || Number(declared)>maxBytes)) {
+          response.destroy();reject(new Error('SOCIAL_DOWNLOAD_LIMIT'));return;
+        }
+        const chunks=[];let size=0;
+        response.on('data',chunk => {
+          size+=chunk.length;
+          if(size>maxBytes){response.destroy();reject(new Error('SOCIAL_DOWNLOAD_LIMIT'));return;}
+          chunks.push(chunk);
+        });
+        response.on('end',()=>resolve({data:Buffer.concat(chunks)}));
+        response.on('error',()=>reject(new Error('SOCIAL_DOWNLOAD_FAILED')));
+      });
+      req.on('error',()=>reject(new Error(signal.aborted ? 'SOCIAL_DOWNLOAD_TIMEOUT' : 'SOCIAL_DOWNLOAD_FAILED')));
+      req.end();
+    });
+    if (result.data) return result.data;
+    try { url = new URL(result.location,url); } catch { throw new Error('SOCIAL_REDIRECT_DENIED'); }
+  }
+  throw new Error('SOCIAL_REDIRECT_DENIED');
+}
