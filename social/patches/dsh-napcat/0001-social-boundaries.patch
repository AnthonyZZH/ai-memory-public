+// Shared by the two pinned plugin patches. No message bodies enter this store.
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createHash, randomUUID } from 'node:crypto';
+
+export const PUBLIC_TOOLS = Object.freeze(['mcp__public__search_notes', 'mcp__public__read_note']);
+export const skip = text => /__SKIP__/i.test(String(text));
+// Social mode is plain text only. A final reply carrying an image/meme/file marker,
+// a Markdown image or a CQ code is dropped whole: never resolved, never stripped and sent.
+const MEDIA_MARKER = /\[\s*(?:图片|表情|文件|image|file)\s*[:：]|!\[[^\]\n]*\]\s*\(|\[CQ:/i;
+export const mediaMarker = text => MEDIA_MARKER.test(String(text));
+// Only fixed event codes pass through to logs; any other detail collapses to its level.
+export const EVENT_CODE = /^SOCIAL_[A-Z0-9_]{1,64}$/;
+export function eventLogger(sink) {
+  return (level, detail) => sink(level, typeof detail === 'string' && EVENT_CODE.test(detail)
+    ? detail : `SOCIAL_${String(level).toUpperCase()}`);
+}
+export function restrictSocialTools(ctx, extra = []) {
+  const allowed = new Set([...PUBLIC_TOOLS, ...extra]);
+  if (!ctx.tools?.guard || !ctx.tools?.restrict) throw new Error('SOCIAL_GUARD_UNAVAILABLE');
+  ctx.tools.restrict({ allow: [...allowed] });
+  ctx.tools.guard(call => allowed.has(call?.name) ? undefined : 'SOCIAL_TOOL_DENIED');
+}
+export function minuteAt(now, timezone) {
+  const parts = new Intl.DateTimeFormat('en-GB', {
+    timeZone: timezone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
+  }).formatToParts(new Date(now));
+  return Number(parts.find(p => p.type === 'hour').value) * 60 + Number(parts.find(p => p.type === 'minute').value);
+}
+
+const LOCK_WAIT_MS = 10_000; // bounded acquisition wait; afterwards fail closed
+const LOCK_STALE_MS = 60_000; // a lock is a stale candidate only after this age...
+// ...and is broken only when its recorded owner process on this host is provably gone.
+const TRANSIENT = new Set(['EPERM', 'EACCES', 'EBUSY']);
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
+const pause = new Int32Array(new SharedArrayBuffer(4));
+// Windows refuses to replace/open a file another process has open at that instant
+// (e.g. a lockless reader). Retry such transient errors briefly (~0.5 s), then throw.
+function retrySync(operation) {
+  for (let attempt = 0; ; attempt++) {
+    try { return operation(); }
+    catch (error) {
+      if (!TRANSIENT.has(error?.code) || attempt >= 8) throw error;
+      Atomics.wait(pause, 0, 0, 2 ** (attempt + 1));
+    }
+  }
+}
+function processAlive(pid) {
+  try { process.kill(pid, 0); return true; } // signal 0 only probes existence
+  catch (error) { return error?.code !== 'ESRCH'; } // EPERM etc.: exists, treat as live
+}
+
+/** Serialize each logical reply (including all its segments) and reserve durably
+ * immediately before transport. An ambiguous failure keeps its reservation:
+ * safety beats retrying a possibly delivered message. No automatic retries.
+ * A corrupt state file fails closed and is retained for inspection.
+ *
+ * Instances/processes sharing one state file serialize every read-modify-write
+ * through `<state>.lock` (exclusive create, JSON {pid,host,at,token}). The lock is
+ * held only for the short critical section, never across transport, so waiters
+ * retry with bounded backoff and then fail closed (SOCIAL_BUDGET_LOCKED). A lock is
+ * broken only if it is older than lockStaleMs AND names a dead pid on this host;
+ * a live, remote or unreadable owner is never overridden. A broken lock is renamed
+ * to `<lock>.stale-<uuid>` for inspection, under a `<lock>.break` guard.
+ */
+export class SendBudget {
+  constructor(filename, { cooldownMinutes, maxPerHour, timezone = 'Asia/Shanghai', now = Date.now,
+    lockWaitMs = LOCK_WAIT_MS, lockStaleMs = LOCK_STALE_MS } = {}) {
+    this.filename = filename;
+    this.lockFile = filename + '.lock';
+    this.cooldown = cooldownMinutes * 60000;
+    this.maxPerHour = maxPerHour;
+    this.timezone = timezone;
+    this.now = now;
+    if (!(lockWaitMs >= 0) || !(lockStaleMs > 0)) throw new Error('SOCIAL_BUDGET_INVALID');
+    this.lockWaitMs = lockWaitMs;
+    this.lockStaleMs = lockStaleMs;
+    minuteAt(now(), timezone); // fail at construction on invalid timezone
+    this.tail = Promise.resolve();
+    this.load(); // validate before processing any messages
+  }
+  load() {
+    let value;
+    try { value = JSON.parse(retrySync(() => fs.readFileSync(this.filename, 'utf8'))); }
+    catch (error) {
+      if (error.code === 'ENOENT') return { version: 1, lastNow: 0, chats: {} };
+      throw new Error('SOCIAL_BUDGET_INVALID');
+    }
+    if (value?.version !== 1 || !Number.isFinite(value.lastNow) || !value.chats || typeof value.chats !== 'object' || Array.isArray(value.chats)) throw new Error('SOCIAL_BUDGET_INVALID');
+    for (const [key, rows] of Object.entries(value.chats)) {
+      if (!/^[a-f0-9]{64}$/.test(key) || !Array.isArray(rows)) throw new Error('SOCIAL_BUDGET_INVALID');
+      for (const row of rows) {
+        if (!Number.isFinite(row.at) || row.at < 0 || typeof row.proactive !== 'boolean' || typeof row.id !== 'string') throw new Error('SOCIAL_BUDGET_INVALID');
+      }
+    }
+    return value;
+  }
+  key(chat) { return createHash('sha256').update(chat).digest('hex'); }
+  rows(chat) { return this.load().chats[this.key(chat)] || []; }
+  eligible(chat, proactive, data = this.load()) {
+    const now = this.now();
+    if (now < data.lastNow) return false;
+    const rows = data.chats[this.key(chat)] || [];
+    if (rows.filter(r => now - r.at < 60000).length >= 6) return false;
+    if (!proactive) return true;
+    const minute = minuteAt(now, this.timezone);
+    if (minute >= 60 && minute < 480) return false;
+    const active = rows.filter(r => r.proactive && now - r.at < 3600000);
+    return active.length < this.maxPerHour && !active.some(r => now - r.at < this.cooldown);
+  }
+  save(value) {
+    const temporary = this.filename + '.' + randomUUID() + '.tmp';
+    const fd = fs.openSync(temporary, 'wx', 0o600);
+    let renamed = false;
+    try {
+      try { fs.writeFileSync(fd, JSON.stringify(value)); fs.fsyncSync(fd); }
+      finally { fs.closeSync(fd); }
+      retrySync(() => fs.renameSync(temporary, this.filename));
+      renamed = true;
+    } finally {
+      if (!renamed) try { fs.unlinkSync(temporary); } catch { /* our own temp file only */ }
+    }
+    // Linux directory fsync persists the rename. Windows does not expose it.
+    if (process.platform !== 'win32') {
+      const dir = fs.openSync(path.dirname(this.filename), 'r');
+      try { fs.fsyncSync(dir); } finally { fs.closeSync(dir); }
+    }
+  }
+  // undefined: no lock; null: transiently unreadable (e.g. Windows delete-pending).
+  readLock() {
+    let raw, stat;
+    try { stat = fs.statSync(this.lockFile); raw = fs.readFileSync(this.lockFile, 'utf8'); }
+    catch (error) {
+      if (error.code === 'ENOENT') return undefined;
+      if (TRANSIENT.has(error.code)) return null;
+      throw error;
+    }
+    let owner;
+    try { owner = JSON.parse(raw); } catch { owner = undefined; }
+    if (!owner || !Number.isInteger(owner.pid) || owner.pid <= 0 || typeof owner.host !== 'string'
+      || typeof owner.token !== 'string' || !Number.isFinite(owner.at)) owner = undefined;
+    return { raw, owner, mtime: stat.mtimeMs };
+  }
+  lockStale(info) {
+    // Unreadable/partial owner records are never broken: fail closed, keep for inspection.
+    if (!info?.owner) return false;
+    // Age counts from the later of recorded time and mtime; a future stamp is never stale.
+    if (Date.now() - Math.max(info.owner.at, info.mtime) < this.lockStaleMs) return false;
+    if (info.owner.host !== os.hostname()) return false; // cannot prove a remote owner dead
+    return !processAlive(info.owner.pid);
+  }
+  breakStaleLock(info) {
+    const guard = this.lockFile + '.break';
+    let fd;
+    try { fd = fs.openSync(guard, 'wx', 0o600); }
+    catch (error) { if (error.code === 'EEXIST' || TRANSIENT.has(error.code)) return false; throw error; }
+    try {
+      // Under the guard, re-check that it is the very same stale record.
+      const again = this.readLock();
+      if (again === undefined) return true;
+      if (!again || again.raw !== info.raw || !this.lockStale(again)) return false;
+      fs.renameSync(this.lockFile, this.lockFile + '.stale-' + randomUUID());
+      return true;
+    } finally { fs.closeSync(fd); fs.unlinkSync(guard); }
+  }
+  async acquireLock() {
+    const token = randomUUID();
+    const record = JSON.stringify({ pid: process.pid, host: os.hostname(), at: Date.now(), token });
+    const deadline = Date.now() + this.lockWaitMs;
+    for (let attempt = 0; ; attempt++) {
+      let fd;
+      try { fd = fs.openSync(this.lockFile, 'wx', 0o600); }
+      catch (error) { if (error.code !== 'EEXIST' && !TRANSIENT.has(error.code)) throw error; }
+      if (fd !== undefined) {
+        let written = false;
+        try { fs.writeFileSync(fd, record); fs.fsyncSync(fd); written = true; }
+        finally {
+          fs.closeSync(fd);
+          if (!written) fs.unlinkSync(this.lockFile); // our own partial record
+        }
+        return token;
+      }
+      const info = this.readLock();
+      const broke = !!info && this.lockStale(info) && this.breakStaleLock(info);
+      const left = deadline - Date.now();
+      if (left <= 0) throw new Error('SOCIAL_BUDGET_LOCKED');
+      if (!broke) {
+        const backoff = Math.min(200, 4 * 2 ** Math.min(attempt, 6));
+        await sleep(Math.min(left, backoff / 2 + Math.random() * backoff / 2));
+      }
+    }
+  }
+  async releaseLock(token) {
+    for (let attempt = 0; ; attempt++) {
+      try {
+        let raw;
+        try { raw = fs.readFileSync(this.lockFile, 'utf8'); }
+        catch (error) { if (error.code === 'ENOENT') return; throw error; }
+        let owner;
+        try { owner = JSON.parse(raw); } catch { owner = undefined; }
+        // Remove only our own record; a lock we no longer own is left untouched.
+        if (owner?.token === token) fs.unlinkSync(this.lockFile);
+        return;
+      } catch (error) {
+        // Windows may transiently refuse while a scanner/reader holds the file.
+        if (!TRANSIENT.has(error.code) || attempt >= 5) throw error;
+        await sleep(20 * (attempt + 1));
+      }
+    }
+  }
+  async withLock(critical) {
+    fs.mkdirSync(path.dirname(this.filename), { recursive: true, mode: 0o700 });
+    const token = await this.acquireLock();
+    try { return critical(); } finally { await this.releaseLock(token); }
+  }
+  send(chat, proactive, deliver) {
+    const work = this.tail.then(async () => {
+      const key = this.key(chat);
+      // Phase 1 (locked): fresh load, eligibility and durable reservation as one step.
+      const id = await this.withLock(() => {
+        const value = this.load();
+        if (!this.eligible(chat, proactive, value)) return undefined;
+        const now = this.now();
+        for (const [k, rows] of Object.entries(value.chats)) {
+          value.chats[k] = rows.filter(r => now - r.at < 3600000);
+          if (!value.chats[k].length) delete value.chats[k];
+        }
+        const row = { at: now, proactive, id: randomUUID(), status: 'reserved' };
+        (value.chats[key] ||= []).push(row); value.lastNow = now;
+        this.save(value); // failure means transport is never called
+        return row.id;
+      });
+      if (id === undefined) return false;
+      await deliver(); // a throw keeps the reservation (fail closed)
+      // Phase 2 (locked, informational): the reservation already counts either way.
+      try {
+        await this.withLock(() => {
+          const value = this.load();
+          const row = (value.chats[key] || []).find(r => r.id === id);
+          if (row) { row.status = 'sent'; this.save(value); }
+        });
+      } catch { /* budget stays reserved; nothing to undo */ }
+      return true;
+    });
+    this.tail = work.catch(() => undefined);
+    return work;
+  }
+}
+
+export function napcatConfig(input) {
+  return {
+    ...input,
+    requireMention: true, triggerKeywords: [...new Set(['小千', ...(input.triggerKeywords || [])])],
+    proactiveEnabled: true, proactiveCooldownMinutes: 10, proactiveMaxPerHour: 4,
+    proactiveQuietHours: '01:00-08:00',
+    socialTimezone: input.socialTimezone || process.env.XQ_SOCIAL_TIMEZONE || 'Asia/Shanghai',
+    memeEnabled: false, faceFallback: false, warmupImages: false, imageCache: 'off',
+    memoryEnabled: false, memoryAutoCapture: false, memoryBackend: 'file', archiveEvery: 0,
+    dmPolicy: 'allowlist', perChatWorkspace: true,
+  };
+}
+
+export function wechatConfig(config) {
+  config.workspaceTools = false;
+  config.codex = { ...config.codex, enabled: false };
+  config.tts = { ...config.tts, enabled: false };
+  config.permissionPreset = 'read-only';
+  config.workspaceMode = 'per-chat';
+  config.toolAllowlist = ['wechat_recent_messages', ...PUBLIC_TOOLS];
+  config.mentionNames = [...new Set(['小千', ...config.mentionNames])];
+  config.reply = { ...config.reply, private: true, groupAll: true, groupMention: true,
+    files: false, images: false, workingNoticeMs: 0, maxRepliesPerMinute: 6, rateLimitWindowMs: 60000 };
+  config.socialTimezone = config.socialTimezone || process.env.XQ_SOCIAL_TIMEZONE || 'Asia/Shanghai';
+  return config;
+}
